# TreeSync — konfigurasi contoh (salin ke .env lalu sesuaikan)
APP_ENV=dev
APP_TZ=Asia/Jakarta
APP_BASE=

# Driver database: 'sqlite' (otomatis & tanpa server) atau 'mysql' (TiDB Cloud / MySQL lokal)
DB_CONNECTION=sqlite

# Database MySQL (jika DB_CONNECTION=mysql)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=treesync
DB_USER=root
DB_PASS=
